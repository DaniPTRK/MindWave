# Sync DSN used by Alembic for offline migrations (uses psycopg2).
DATABASE_URL_SYNC=postgresql+psycopg2://mindwave:mindwave123@postgres:5432/mindwave

# Generate with: openssl rand -hex 32
SECRET_KEY=4mLu4777r4nd4firiSi7inL0cD34min7iriD3spr37in3SiIiPunP3P3rn474SiM4Min73Inim4P0473Vin3PrinLum3R474c3scCuS73l3l3V0rb3scUnd33s7i04r3SiNim3niNuV4S7iC3Mul7N0iN34mIubi7
ACCESS_TOKEN_EXPIRE_MINUTES=60

# k-anonymity threshold for HR-facing aggregate stats
